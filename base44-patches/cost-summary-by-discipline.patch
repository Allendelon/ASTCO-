+const pct = (v) => (v === null || v === undefined ? "—" : `${v >= 0 ? "" : "−"}${Math.abs(v).toFixed(1)}%`);
+const signed = (v, currency) => (v < 0 ? `−${money(-v, currency)}` : money(v, currency));
